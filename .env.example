# Copy to .env and fill in your values. Never commit .env.

# Server
PORT=3000
BASE_URL=https://your-domain.com   # used for Stripe redirect URLs; local dev can omit

# Stripe — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Optional but recommended: webhook for instant confirmation (else /api/bookings/confirm covers it)
STRIPE_WEBHOOK_SECRET=whsec_...

# Gmail — use an App Password, NOT your Gmail password:
# Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=onetouchcleaning.bf@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Owner notifications go to this address (defaults to GMAIL_USER)
OWNER_EMAIL=onetouchcleaning.bf@gmail.com

# Admin dashboard password — pick something strong
ADMIN_PASSWORD=choose-a-strong-password

# Secret for the reminder cron endpoint: GET /api/cron/reminders?secret=...
CRON_SECRET=choose-a-long-random-secret

# Optional: override sqlite file location
# DB_PATH=/var/data/bookings.db
